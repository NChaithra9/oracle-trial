# Copy this file to ".env" (or export these as real environment variables)
# and fill in your own values. Never commit real secrets to Git.

# API key for the OpenAI-compatible embedding/LLM provider.
OPENAI_API_KEY=your-openai-api-key-here

# Optional: override the default model names.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Qdrant connection. QDRANT_URL must include the scheme and gRPC port
# (default gRPC port is 6334, not the 6333 REST port).
QDRANT_URL=http://localhost:6334
QDRANT_API_KEY=
QDRANT_COLLECTION=oracle_trial_documents
